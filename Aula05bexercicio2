public class Aula05bexercicio2 {
    
    public static void main(String[] args) {
        
        String tit= "temperatura";
        
        
        String numero = JOptionPane.showInputDialog(null, "Quantas medições pretende fazer??", tit, 3);
        
        int numeroMedicoes= Integer.parseInt(numero);
       
       double  somatemp=0;
        double somaMedia=0;
        
        for (int i = 1; i <= numeroMedicoes; i++){
            
            double temp= Double.parseDouble(JOptionPane.showInputDialog(null, "digite a"+ i + "temperatura", tit, 3));
            somatemp += temp;
    }
        somaMedia = somatemp/numeroMedicoes;
        JOptionPane.showMessageDialog (null, "a media das temperaturas citadas é igual a = "+ String.format("%.1f",somaMedia,tit,3));
      
    }
}
