public class aula3cexercicio {
     public static void main(String[] args) {
         
         
         String lado1Str = JOptionPane.showInputDialog (null,
                 "Digite o primeiro lado e um triangulo");
         
          String lado2Str = JOptionPane.showInputDialog (null,
                 "Digite o segundo lado e um triangulo");
          
         String lado3Str = JOptionPane.showInputDialog (null,
                 "Digite o terceiro lado e um triangulo");
           
           
        double lado1 =  Double.parseDouble(lado1Str);
        double lado2 =  Double.parseDouble(lado2Str);
        double lado3 =  Double.parseDouble(lado3Str);
        
       String msg = "";
       
      if  (( lado1 + lado2 <= lado3) ||
           (lado1 + lado3 < lado2) || 
            (lado2 + lado3 < lado1))
              { msg= "Os valores nao formam um triangulo";
              
      }
      else if (lado1 == lado2 && lado2 == lado3) {
            msg= "O Triangulo é equilatero";      
    }
      else if (lado1== lado2 ||
               lado1 == lado3 ||
               lado2==lado3 ){
              
             msg= "O triangulo é isósceles";        
    } 
      else {
              
             msg= "O triangulo é escaleno";
    }
    
    JOptionPane.showMessageDialog(
            null, msg,
            "classificação do seu triangulo", 1);
      
      
      
      
      
      
}
       
        
        
           
           
         
         
         
